# =========================================================================
# SUIVIBUDGET CÔTE D'IVOIRE - VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier en '.env' et complétez avec vos identifiants Supabase.
# SÉCURITÉ : Ne mettez JAMAIS la clé 'service_role' dans ce fichier !
# =========================================================================

# URL de votre projet Supabase (Ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://votre-identifiant.supabase.co

# Clé API Publique 'anon' (commençant par eyJ...)
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique_ici
